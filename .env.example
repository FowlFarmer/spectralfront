# Upstash Redis (added automatically by the Vercel Upstash integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Metered TURN (server-only; never prefix these with NEXT_PUBLIC_)
# From Metered Dashboard → Developers. The domain looks like your-app.metered.live.
METERED_TURN_DOMAIN=
METERED_TURN_API_KEY=
# Optional: global is Metered's default; set a supported region only when needed.
METERED_TURN_REGION=

# Alternative for a dashboard-created static credential. Keep all TURN URLs comma-separated.
# Prefer the API-key option above when it is available, so credentials can be rotated centrally.
METERED_TURN_URLS=
METERED_TURN_USERNAME=
METERED_TURN_CREDENTIAL=
