# Upstash Redis (added automatically by the Vercel Upstash integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Metered TURN (server-only; never prefix these with NEXT_PUBLIC_)
# From Metered Dashboard → Developers. The domain looks like your-app.metered.live.
METERED_TURN_DOMAIN=
METERED_TURN_API_KEY=
# Optional: global is Metered's default; set a supported region only when needed.
METERED_TURN_REGION=
